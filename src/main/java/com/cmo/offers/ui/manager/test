import com.cmo.offers.model.SheetData;
import com.cmo.offers.export.CsvExporter;

import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.GridPane;
import javafx.stage.DirectoryChooser;
import javafx.stage.Stage;

import java.io.File;
import java.nio.file.Path;

public class MainApp extends Application{
	  @Override
	    public void start(Stage stage) {

	        // Input fields
	        TextField nameField = new TextField();
	        TextField inputAField = new TextField();
	        TextField inputBField = new TextField();

	        // Export button
	        Button exportButton = new Button("Export CSV");

	        // Status label
	        Label statusLabel = new Label();

	        // Button logic
	        exportButton.setOnAction(e -> {
	            try {
	                String sheetName = nameField.getText().trim();
	                double a = Double.parseDouble(inputAField.getText().trim());
	                double b = Double.parseDouble(inputBField.getText().trim());

	                if(sheetName.isEmpty()) {
	                    statusLabel.setText("Sheet name cannot be empty!");
	                    return;
	                }

	                SheetData sheetData = new SheetData(sheetName, a, b);

	                DirectoryChooser chooser = new DirectoryChooser();
	                chooser.setTitle("Select Export Folder");
	                File dir = chooser.showDialog(stage);

	                if (dir != null) {
	                    CsvExporter.export(sheetData, dir.toPath());
	                    statusLabel.setText("Exported: " + sheetName + ".csv");
	                    nameField.clear();
	                    inputAField.clear();
	                    inputBField.clear();
	                }

	            } catch (NumberFormatException ex) {
	                statusLabel.setText("Inputs must be numeric!");
	            } catch (Exception ex) {
	                statusLabel.setText("Error exporting file!");
	                ex.printStackTrace();
	            }
	        });

	        // Layout
	        GridPane grid = new GridPane();
	        grid.setPadding(new Insets(15));
	        grid.setHgap(10);
	        grid.setVgap(10);

	        grid.add(new Label("Sheet Name:"), 0, 0);
	        grid.add(nameField, 1, 0);

	        grid.add(new Label("Input A:"), 0, 1);
	        grid.add(inputAField, 1, 1);

	        grid.add(new Label("Input B:"), 0, 2);
	        grid.add(inputBField, 1, 2);

	        grid.add(exportButton, 1, 3);
	        grid.add(statusLabel, 1, 4);

	        // Scene
	        Scene scene = new Scene(grid, 400, 250);
	        stage.setTitle("Sheet Exporter");
	        stage.setScene(scene);
	        stage.show();
	    }

	    public static void main(String[] args) {
	        launch(args);
	    }
}
